<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="api" parallel="methods" thread-count="4">
    <test name="api">
        <groups>
            <run>
                <exclude name="local-only"/>
                <exclude name="slow"/>
                <exclude name="known-bug"/>
                <exclude name="registration-closed"/>
            </run>
        </groups>
        <packages>
            <package name="api.*"/>
        </packages>
    </test>
</suite>
