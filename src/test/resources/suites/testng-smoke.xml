<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="smoke">
    <test name="smoke">
        <groups>
            <run>
                <include name="smoke"/>
                <exclude name="known-bug"/>
            </run>
        </groups>
        <packages>
            <package name="api.*"/>
        </packages>
    </test>
</suite>
